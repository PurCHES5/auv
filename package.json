{
  "name": "@auv-js/root",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @auv-js/api-client --filter \"./js/packages/*\" --if-present build",
    "generate:proto": "cd proto && buf generate --template buf.gen.yaml",
    "lint:fix": "eslint --cache . --fix",
    "lint": "eslint --cache .",
    "test:run": "pnpm --filter @auv-js/api-client --filter \"./js/packages/*\" --if-present test:run",
    "typecheck": "pnpm --filter @auv-js/api-client --filter \"./js/packages/*\" --if-present typecheck",
    "up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "nolyfill": "pnpm dlx nolyfill"
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@auv-js/alint-config": "workspace:*",
    "@moeru/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "nano-staged": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "taze": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:vitest"
  }
}
